# Backend API Base URL (REST, SSE, and Socket.IO)
VITE_API_BASE_URL=http://localhost:3000

# Opt-in MSW (Mock Service Worker) for offline development. Set to "true" and
# run `pnpm dev` to serve fixture data for the education, stats, and pools
# endpoints so the Learn, Dashboard, and Pools pages work without a backend.
# See the README section "Mocking the API with MSW".
# VITE_ENABLE_MSW=true



# Stellar network this build targets. Set to PUBLIC for mainnet.
# Selects the app badge, the default Horizon endpoint, the StellarExpert explorer
# network, and the Friendbot CTA. It is also the network Freighter must be on:
# when the wallet reports a different one, the app shows a mismatch card with
# switch instructions instead of letting funding and signing fail silently.
VITE_STELLAR_NETWORK=TESTNET

# Horizon endpoint used for account balances and trustlines.
# Optional — defaults to horizon-testnet.stellar.org, or horizon.stellar.org when
# VITE_STELLAR_NETWORK is PUBLIC/MAINNET. Set this only to override that default.
# VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Friendbot (testnet faucet) endpoint powering the "Fund with Friendbot" CTA.
# Optional — defaults to friendbot.stellar.org. The CTA is hidden entirely when
# VITE_STELLAR_NETWORK is PUBLIC/MAINNET, where no faucet exists.
# VITE_STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
